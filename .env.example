# Pulso environment for the API, the workers and the dev infrastructure.
# Copy to `.env` (gitignored) and fill in the empty values. Never commit real values.
# Linked worktrees also get a generated `.env.local` (infra/scripts/worktree_env.py) that
# overrides the per-worktree values; settings read `.env`, then `.env.local`, then real env vars.
# The web app keeps its own variables in apps/web/.env.local (web lane).

# --- Dev infrastructure (infra/docker-compose.yml). Host ports bind to 127.0.0.1 only. ---
# Password of the local Postgres superuser `pulso`. Pick any local value.
PG_PASSWORD=
# Host port for Postgres.
PG_PORT=5432
# Host port for Redis.
REDIS_PORT=6379
# Host ports for the RustFS S3 API and its web console.
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Database and Redis (API, workers, Alembic) ---
# SQLAlchemy URL with the psycopg 3 driver. Locally:
# postgresql+psycopg://pulso:<PG_PASSWORD>@localhost:<PG_PORT>/pulso
DATABASE_URL=
# Optional integration tests: pulso_ci or dedicated pulso_test* database; never the collector DB.
TEST_DATABASE_URL=
# Celery broker and cache. Worktrees get their own DB number (/1../15).
REDIS_URL=redis://localhost:6379/0

# --- Object storage: RustFS locally, Cloudflare R2 in production ---
# Native processes use localhost; containers would use http://s3:9000.
S3_ENDPOINT_URL=http://localhost:9000
# `us-east-1` for RustFS, `auto` for R2.
S3_REGION=us-east-1
# Bucket for raw source payloads. Create it locally with `uv run python -m pulso_core.s3 init`.
S3_BUCKET_RAW=pulso-raw
# Locally these are also the RustFS root credentials (compose reads them). Pick any local values.
# In production: an R2 API token scoped to the bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth: Clerk JWT verification in the API (DEC-020) ---
# Issuer of the Clerk development instance, e.g. https://<instance>.clerk.accounts.dev
CLERK_ISSUER=
# JWKS URL of the same instance, e.g. https://<instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Comma-separated origins accepted in the token's `azp` claim (the web app's URL).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Comma-separated Clerk user ids allowed into the app in v1 (the owner's id).
PLATFORM_ADMIN_USER_IDS=

# --- Scheduler safety (DEC-002). `on` ONLY on the collector host (its .env.collector). ---
# Runs Celery Beat schedules.
PULSO_SCHEDULER=off
# Lets collectors call live sources. Off = fixtures, seeds and CSV only.
COLLECTORS_LIVE=off

# Public bot contact URL for the owner-run Shopify spike; export in PowerShell before running.
PULSO_BOT_CONTACT=

# --- API and logging ---
# Port for `pnpm dev:api` (uvicorn).
API_PORT=8000
# Python logging level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# `json` (structured logs, default) or `text` (human-readable, local debugging).
LOG_FORMAT=json

# --- Written to .env.local by worktree_env.py (listed for reference; leave unset in .env) ---
# PULSO_WORKTREE_SLUG=   worktree folder name, used in the database name pulso_<slug>
# PULSO_WORKTREE_SLOT=   1-15; offsets the ports and picks the Redis DB
# WEB_PORT=3000          port for `pnpm dev:web` (wired by the web lane)
# API_URL=http://localhost:8000   where the web app's /api/* rewrite sends requests

# --- Web app (apps/web) ---
# The web app keeps Clerk keys and its own settings in apps/web/.env.local; see apps/web/.env.example.
# `pnpm dev:web` also reads WEB_PORT, API_URL and PLATFORM_ADMIN_USER_IDS from this file and the
# worktree's .env.local (real env vars win), so the API and the web gate share one allowlist.
