# Pulso environment for the API, the workers and the dev infrastructure.
# Copy to `.env` (gitignored) and fill in the empty values. Never commit real values.
# Linked worktrees also get a generated `.env.local` (infra/scripts/worktree_env.py) that
# overrides the per-worktree values; settings read `.env`, then `.env.local`, then real env vars.
# The web app keeps its own variables in apps/web/.env.local (web lane).

# --- Dev infrastructure (infra/docker-compose.yml). Host ports bind to 127.0.0.1 only. ---
# Password of the local Postgres superuser `pulso`. Pick any local value.
PG_PASSWORD=
# Host port for Postgres.
PG_PORT=5432
# Host port for Redis.
REDIS_PORT=6379
# Host ports for the RustFS S3 API and its web console.
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Database and Redis (API, workers, Alembic) ---
# SQLAlchemy URL with the psycopg 3 driver. Locally:
# postgresql+psycopg://pulso:<PG_PASSWORD>@localhost:<PG_PORT>/pulso
DATABASE_URL=
# Optional integration tests: pulso_ci or dedicated pulso_test* database; never the collector DB.
TEST_DATABASE_URL=
# Celery broker and cache. Worktrees get their own DB number (/1../15).
REDIS_URL=redis://localhost:6379/0

# --- Object storage: RustFS locally, Cloudflare R2 in production ---
# Native processes use localhost; containers would use http://s3:9000.
S3_ENDPOINT_URL=http://localhost:9000
# `us-east-1` for RustFS, `auto` for R2.
S3_REGION=us-east-1
# Bucket for raw source payloads. Create it locally with `uv run python -m pulso_core.s3 init`.
S3_BUCKET_RAW=pulso-raw
# Locally these are also the RustFS root credentials (compose reads them). Pick any local values.
# In production: an R2 API token scoped to the bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Auth: Clerk JWT verification in the API (DEC-020) ---
# Issuer of the Clerk development instance, e.g. https://<instance>.clerk.accounts.dev
CLERK_ISSUER=
# JWKS URL of the same instance, e.g. https://<instance>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=
# Comma-separated origins accepted in the token's `azp` claim (the web app's URL).
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Comma-separated Clerk user ids allowed into the app in v1 (the owner's id).
PLATFORM_ADMIN_USER_IDS=

# --- Scheduler safety (DEC-002). `on` ONLY on the collector host (its .env.collector). ---
# Runs Celery Beat schedules.
PULSO_SCHEDULER=off
# Lets collectors call live sources. Off = fixtures, seeds and CSV only.
COLLECTORS_LIVE=off

# --- Collector host only: owner supplies .env.collector; never copy it to a worktree. ---
# The collector profile reads this file directly (literal, unquoted values), not shell flags.
# Required names in .env.collector: DATABASE_URL, REDIS_URL, S3_ENDPOINT_URL, S3_REGION,
# S3_BUCKET_RAW, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, PG_PASSWORD; descriptions above.
# DATABASE_URL uses postgres:5432/pulso; REDIS_URL uses redis:6379/0; S3_ENDPOINT_URL uses s3:9000.
# PG_PORT, REDIS_PORT, S3_PORT, S3_CONSOLE_PORT must differ from dev; suggested 55432/56379/59000/59001.
# PULSO_SCHEDULER and COLLECTORS_LIVE belong only in .env.collector; retain off until ready.
# PULSO_BOT_CONTACT and source-specific variables below are also supplied there when needed.
# LOG_LEVEL and LOG_FORMAT below apply to collector containers when present in that file.

# Public HTTP(S) contact URL; required to build the honest PulsoBot/0.1 User-Agent for live fetches.
PULSO_BOT_CONTACT=

# --- Phase 1 collector defaults (P1-03; enforcement belongs to framework/adapters/workers) ---
# Consecutive 403/429/430 responses before source auto-disable (P1-03b).
COLLECTOR_BLOCK_THRESHOLD=5
# Additional request retries for timeouts/connection failures and 500/502/503/504.
COLLECTOR_MAX_RETRIES=3
# Exponential retry base in seconds (multiplier 4: 2, 8, then capped 30).
COLLECTOR_BACKOFF_BASE_SECONDS=2
# Maximum request backoff in seconds.
COLLECTOR_BACKOFF_CAP_SECONDS=30
# Maximum in-process Retry-After wait, seconds (0..600); preserve the full deadline (P1-03b).
COLLECTOR_RETRY_WAIT_CAP_SECONDS=600
# Default plan wall-time budget, seconds; unfinished targets end partial.
COLLECTOR_WALL_TIME_SECONDS=2700
# Celery collect soft time limit, seconds (P1-04).
COLLECT_SOFT_TIME_LIMIT_SECONDS=3600
# Celery collect hard time limit, seconds (P1-04).
COLLECT_HARD_TIME_LIMIT_SECONDS=4500
# Celery task-level retries after a crash (P1-04).
COLLECTOR_TASK_MAX_RETRIES=2
# Celery crash retry countdown, seconds (P1-04).
COLLECTOR_TASK_RETRY_SECONDS=900
# Adapter HTTP timeout, seconds; adapters translate transport failures to TimeoutError/ConnectionError.
COLLECTOR_REQUEST_TIMEOUT_SECONDS=30
# Shared Shopify request ceiling across all hosts (1..30/min, P1-07).
SHOPIFY_REQUESTS_PER_MINUTE=30
# Tracked .js products per approved store; starts 10, owner may raise to 20 after 7 clear days.
SHOPIFY_JS_PANEL_SIZE=10
# Shopify plan wall-time budget, seconds; pass to execute_run (P1-07).
SHOPIFY_WALL_TIME_SECONDS=1800
# Owner-provided CJ key; never commit a real value (P1-08).
CJ_API_KEY=
# CJ account level 0-1 request ceiling (at most 1/second, P1-08).
CJ_REQUESTS_PER_SECOND=1
# Daily CJ point budget, capped at 20000; reserve quota before every request (P1-08).
CJ_DAILY_POINTS_BUDGET=20000
# CJ plan wall-time budget, seconds (P1-08).
CJ_WALL_TIME_SECONDS=1800
# Owner-provided SerpApi key; missing key stops live Trends without spending quota (DEC-099).
SERPAPI_API_KEY=
# Hard UTC-calendar-month Trends ceiling (0..250); reserve before every attempt (DEC-099).
TRENDS_MONTHLY_SEARCH_LIMIT=250
# SerpApi attempts in any rolling 60 minutes (1..50, free plan's hourly cap); stops partial (DEC-154).
TRENDS_HOURLY_SEARCH_LIMIT=50
# Trends plan wall-time budget, seconds (P1-09).
TRENDS_WALL_TIME_SECONDS=600
# Frankfurter FX plan wall-time budget, seconds (P1-09).
FX_WALL_TIME_SECONDS=300
# Listing image hosts (DEC-240): comma-separated exact https hosts; empty fetches nothing.
# List a host only after its robots.txt and terms are checked in docs/DATA_SOURCES.md.
IMAGE_HOSTS=
# Listing image requests per minute per host (1..30); robots Crawl-delay can only slow it.
IMAGE_REQUESTS_PER_MINUTE=30
# Product matcher on the ml queue (DEC-249): on/off. Off, the task logs and writes nothing.
MATCHER_ENABLED=off
# OpenCLIP image + title embeddings on the ml queue (DEC-269): on/off. Off, the task logs and
# writes nothing. On needs the ml worker's `clip` extra and its baked weights (no download).
EMBEDDINGS_ENABLED=off

# --- API and logging ---
# Port for `pnpm dev:api` (uvicorn).
API_PORT=8000
# Python logging level: DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# `json` (structured logs, default) or `text` (human-readable, local debugging).
LOG_FORMAT=json

# --- Written to .env.local by worktree_env.py (listed for reference; leave unset in .env) ---
# PULSO_WORKTREE_SLUG=   worktree folder name, used in the database name pulso_<slug>
# PULSO_WORKTREE_SLOT=   1-15; offsets the ports and picks the Redis DB
# WEB_PORT=3000          port for `pnpm dev:web` (wired by the web lane)
# API_URL=http://localhost:8000   where the web app's /api/* rewrite sends requests

# --- Web app (apps/web) ---
# The web app keeps Clerk keys and its own settings in apps/web/.env.local; see apps/web/.env.example.
# `pnpm dev:web` also reads WEB_PORT, API_URL and PLATFORM_ADMIN_USER_IDS from this file and the
# worktree's .env.local (real env vars win), so the API and the web gate share one allowlist.
