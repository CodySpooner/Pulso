# Pulso web app (apps/web). Copy to apps/web/.env.local (gitignored) and fill in. Never commit real values.

# --- Clerk (DEC-020). Development instance keys from the Clerk dashboard → API keys. ---
# Without them `next build` still works, but every page fails closed (Clerk throws) until they are set.
# In `next dev` with no keys, Clerk provisions temporary "keyless" dev keys unless the line below is 1.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# 1 = never provision temporary keyless dev keys (recommended once real keys exist).
NEXT_PUBLIC_CLERK_KEYLESS_DISABLED=

# --- Access gate. Comma-separated Clerk user ids allowed in (the same list the API reads). ---
# Empty admits nobody: signed-in users land on /not-authorized, which shows their user id to copy here.
# `pnpm dev:web` falls back to the value in the repo-root .env.
PLATFORM_ADMIN_USER_IDS=

# --- API proxy. /api/* is rewritten to this URL (no CORS). ---
# Read when Next loads its config: at `next dev` start and at `next build` (baked into the build output).
# `pnpm dev:web` falls back to the repo-root .env.local that infra/scripts/worktree_env.py writes.
API_URL=http://localhost:8000

# --- E2E only. 1 runs `next dev` without Clerk so Playwright can drive the shell before keys exist. ---
# Production builds compile this check away (src/lib/auth.ts), so it can never disable auth there.
NEXT_PUBLIC_PULSO_E2E_AUTH_BYPASS=
